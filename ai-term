def flush_stdin() -> None:
    try:
        import termios  # type: ignore

        termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
    except Exception:
        pass


class ChatSpinner:
    """
    Spinner untuk mode chat:
    - Tanpa timer
    - Input user dibisukan total saat menunggu (echo off + flush)
    """
    def __init__(self, message: str = "Aku lagi mikir..."):
        self.message = message
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._spin, daemon=True)
        self._mute = MuteInputDuringWait()

    def _spin(self) -> None:
        frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
        i = 0
        sys.stdout.write(f"{c_dim()}{self.message}{c_reset()} ")
        sys.stdout.flush()
        while not self._stop.is_set():
            sys.stdout.write(frames[i % len(frames)])
            sys.stdout.flush()
            time.sleep(0.08)
            sys.stdout.write("\b")
            i += 1
        sys.stdout.write(f"{c_green()}✅{c_reset()}\n")
        sys.stdout.flush()

    def __enter__(self):
        self._mute.__enter__()
        self._thread.start()
        return self

    def __exit__(self, exc_type, exc, tb):
        try:
            self._stop.set()
            self._thread.join(timeout=1)
        finally:
            self._mute.__exit__(exc_type, exc, tb)
        return False


class MuteInputDuringWait:
    """
    Aku membisukan input user saat mode waiting:
    - Matikan echo (ketikan tidak tampil)
    - Buang semua ketikan saat menunggu (flush)
    Catatan: Ctrl+C tetap jalan karena aku tidak mematikan ISIG.
    """
    def __init__(self) -> None:
        self._enabled = False
        self._fd: int | None = None
        self._old_attrs = None

    def __enter__(self):
        flush_stdin()

        try:
            if not sys.stdin.isatty():
                return self
            import termios  # type: ignore

            self._fd = sys.stdin.fileno()
            self._old_attrs = termios.tcgetattr(self._fd)
            new_attrs = termios.tcgetattr(self._fd)

            # local flags (lflags) index = 3
            lflags = new_attrs[3]

            # Matikan ECHO supaya ketikan user tidak tampil saat spinner jalan
            lflags &= ~termios.ECHO

            # Opsional: matikan ECHOCTL agar Ctrl+C tidak menulis "^C" (kalau tersedia)
            if hasattr(termios, "ECHOCTL"):
                lflags &= ~termios.ECHOCTL  # type: ignore[attr-defined]

            new_attrs[3] = lflags
            termios.tcsetattr(self._fd, termios.TCSANOW, new_attrs)
            self._enabled = True

        except Exception:
            # Kalau gagal (mis. environment aneh), aku biarkan fallback normal
            self._enabled = False

        return self

    def __exit__(self, exc_type, exc, tb):
        # Buang semua ketikan yang terjadi selama waiting
        flush_stdin()

        if self._enabled and self._fd is not None and self._old_attrs is not None:
            try:
                import termios  # type: ignore

                termios.tcsetattr(self._fd, termios.TCSANOW, self._old_attrs)
            except Exception:
                pass

        # Amanin sekali lagi
        flush_stdin()
        return False


def prompt_text(prompt: str) -> str:
    try:
        from prompt_toolkit import PromptSession  # type: ignore
        from prompt_toolkit.formatted_text import ANSI  # type: ignore

        return PromptSession().prompt(ANSI(prompt), mouse_support=False)
    except Exception:
        return input(prompt)


# ============================================================
# 4) Spinner + timer (untuk ask one-shot & cmd)
# ============================================================

class Spinner:
    def __init__(self, message: str):
        self.message = message
        self._stop = threading.Event()
        self._mute = MuteInputDuringWait()
        self._thread = threading.Thread(target=self._spin, daemon=True)
        self._t0 = 0.0

    def _spin(self) -> None:
        frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
        i = 0
        sys.stdout.write(f"{c_dim()}{self.message}{c_reset()} ")
        sys.stdout.flush()
        while not self._stop.is_set():
            sys.stdout.write(frames[i % len(frames)])
            sys.stdout.flush()
            time.sleep(0.08)
            sys.stdout.write("\b")
            i += 1
        dt = max(0.0, time.time() - self._t0)
        sys.stdout.write(f"{c_green()}✅{c_reset()} {c_dim()}⏱ {dt:.2f}s{c_reset()}\n")
        sys.stdout.flush()

    def __enter__(self):
        self._t0 = time.time()
        self._mute.__enter__()
        self._thread.start()
        return self


    def __exit__(self, exc_type, exc, tb):
        try:
            self._stop.set()
            self._thread.join(timeout=1)
        finally:
            # Restore echo + buang semua input yang terjadi selama waiting
            self._mute.__exit__(exc_type, exc, tb)


