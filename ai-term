                except Exception as ex:
                    record_last_error("memory_summary", "api", str(ex))

    finally:
        cursor_show()
        alt_screen_exit()

    # Cetak pamit lagi di terminal normal biar pasti kelihatan walau alt-screen nutup cepat.
    if exit_requested:
        _print_goodbye("api" if persona_at_exit == "api" else "local", interrupted)

