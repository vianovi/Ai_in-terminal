    # --- Persona + System Instruction Chat (lebih luas dari cmd) ---
    def persona_for(backend_now: str) -> tuple[str, str, str, str]:
        """
        Return:
          label, greeting, goodbye, system_prompt_chat
        """
        if backend_now == "api":
            label = "Sili Pinter 💖"
