            open_code(LOGIC_PATH)
            open_code(CONFIG_PATH)
        elif ans in ("ai-term", "logic"):
            open_code(LOGIC_PATH)
        elif ans == "config":
            open_code(CONFIG_PATH)
        elif ans == "memory":
            open_code(MEMORY_PATH)
        elif ans == "error":
            open_code(LAST_ERROR_PATH)
        elif ans == "fish":
            open_code(FISH_DIR)
        elif ans == "funcs":
            open_code(FISH_FUNCS_DIR)
        else:
            print_info("Pilihan tidak dikenal.")
    except Exception as ex:
        record_last_error("ai_status_open", "local", str(ex))
        print_brief_error(f"Gagal membuka VS Code: {ex}")

    return 0


def mode_ai(text: str, cfg: dict) -> int:
    t = text.strip().lower()
    if t in ("status", "buka file konfigurasi"):
        return ai_status(cfg)
    print('Gunakan: ai "status"')
    return 2


# ============================================================
# 16) Main entry
# ============================================================

def main() -> int:
    if len(sys.argv) < 3:
        print("Format penggunaan:")
        print('  ask "..."')
        print('  cmd "..."')
        print('  ai "status"')
        return 2

    mode = sys.argv[1].strip().lower()
    text = " ".join(sys.argv[2:]).strip()
    cfg = load_config()

    if mode == "ask":
        return mode_ask(text, cfg)
    if mode == "cmd":
        return mode_cmd(text, cfg)
    if mode == "ai":
        return mode_ai(text, cfg)

    print("Mode tidak dikenal. Pakai: ask / cmd / ai.")
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nDibatalkan oleh pengguna.")
        raise SystemExit(130)
