            "CATATAN: Aturan halus: usahakan 3–4 baris kalau memungkinkan."
        )
        return label, greeting, goodbye, system_prompt

    # --- Header UI (adaptif, bukan box) ---
    def print_header(current_backend: str, current_route: str) -> None:
        cols, _ = term_size()
        clear_screen()
        sys.stdout.write(
            f"{tag('SILI CHAT', c_cyan())} {tag(mode.upper(), c_yellow())} {c_dim()}•{c_reset()} {current_route}\n"
        )
        sys.stdout.write(f"{c_dim()}Ketik \"exit\" / \"keluar\" untuk menutup sesi.{c_reset()}\n")
        sys.stdout.write(f"{c_dim()}(Ctrl+C juga bisa untuk keluar){c_reset()}\n\n")
        sys.stdout.flush()

    # --- Setup history + memory context ---
    mem_ctx = mem_context_text(cfg).strip()
    label, greeting, goodbye, sys_prompt = persona_for(backend)

    history: list[dict] = [{"role": "system", "content": sys_prompt}]
    if mem_ctx:
        history.append({"role": "system", "content": mem_ctx})

    # --- Exit handling: supaya pamit pasti muncul di terminal normal ---
    exit_requested = False
    interrupted = False
    persona_at_exit = "api" if backend == "api" else "local"

    used_api_at_least_once = False

    alt_screen_enter()
    cursor_hide()
    try:
        print_header(backend, route)
        sys.stdout.write(f"{c_bold()}{label}:{c_reset()} {greeting}\n\n")
        sys.stdout.flush()

        while True:
            # Input user (pakai prompt_toolkit jika ada; mouse scroll tidak nyasar karena mouse_support=False)
            try:
                flush_stdin()
                user = prompt_text(f"{c_cyan()}User 🧑‍💻{c_reset()} {c_dim()}›{c_reset()} ").strip()
            except KeyboardInterrupt:
                exit_requested = True
                interrupted = True
                persona_at_exit = "api" if backend == "api" else "local"
                break

            if not user:
                continue

            if user.lower() in ("exit", "keluar", "quit"):
                exit_requested = True
                interrupted = False
                persona_at_exit = "api" if backend == "api" else "local"
                break

            # Tambahkan ke history
            history.append({"role": "user", "content": user})

            # ================
            # API path
            # ================
            if backend == "api":
                ok, note, detail = validate_api_config(cfg)
                if not ok:
                    # Mode api -> ringkas, lalu fallback
                    record_last_error("ask_chat", "api", f"{note}\n{detail}")
                    if mode == "api":
                        sys.stdout.write(
                            f"{tag('SISTEM', c_yellow())} API lagi tidak siap. Aku pindah ke LOCAL dulu ya.\n"
)

                    backend = "local"
                    route = f"{tag('AUTO', c_yellow())} -> {tag('LOCAL', c_green())} • {local_model_for(cfg, 'ask') or '(unset)'}"
                    label, greeting, goodbye, sys_prompt = persona_for("local")
                    history[0] = {"role": "system", "content": sys_prompt}
                    # lanjut ke LOCAL handling untuk pertanyaan ini
                else:
                    try:
                        with ChatSpinner("Aku lagi mikir..."):
                            answer = gemini_generate(cfg, history, timeout=90, max_output_tokens=api_tokens_chat())

                        flush_stdin()
                        used_api_at_least_once = True
                        history.append({"role": "assistant", "content": answer})

                        sys.stdout.write(f"{c_dim()}────────────────────────────────────────{c_reset()}\n")
                        sys.stdout.write(f"{c_bold()}{label}:{c_reset()} {answer}\n\n")
                        sys.stdout.flush()
                        continue

                    except KeyboardInterrupt:
                        record_last_error("ask_chat", "api", "KeyboardInterrupt saat menunggu API (chat).")
                        exit_requested = True
                        interrupted = True
                        persona_at_exit = "api"
                        break

                    except Exception as ex:
                        record_last_error("ask_chat", "api", str(ex))
                        sys.stdout.write(
                            f"{tag('SISTEM AI', c_yellow())} API lagi tidak siap. Aku pindah ke LOCAL dulu ya.\n"
                            )
                        sys.stdout.write(f"{c_dim()}(mode: {mode.upper()} • fallback otomatis){c_reset()}\n\n")
                        sys.stdout.write(f"{c_dim()}(cek detail: ai \"status\"){c_reset()}\n\n")
                        sys.stdout.flush()

                        backend = "local"
                        route = f"{tag('AUTO', c_yellow())} -> {tag('LOCAL', c_green())} • {local_model_for(cfg, 'ask') or '(unset)'}"
                        label, greeting, goodbye, sys_prompt = persona_for("local")
                        history[0] = {"role": "system", "content": sys_prompt}
                        # lanjut ke LOCAL handling untuk pertanyaan ini

            # ================
            # LOCAL path (jalan normal atau hasil fallback dari API)
            # ================
            try:
                host = ollama_host(cfg)
                m = local_model_for(cfg, "ask") or "llama3.1:8b"
                tok = local_tokens_for_chat(user)

                with ChatSpinner("Aku lagi mikir..."):
                    answer = ollama_chat(host, m, history, timeout=260, num_predict=tok)

                flush_stdin()
                history.append({"role": "assistant", "content": answer})

                sys.stdout.write(f"{c_dim()}────────────────────────────────────────{c_reset()}\n")
                sys.stdout.write(f"{c_bold()}{label}:{c_reset()} {answer}\n\n")
                sys.stdout.flush()

            except KeyboardInterrupt:
                record_last_error("ask_chat", "local", "KeyboardInterrupt saat menunggu LOCAL (chat).")
                exit_requested = True
                interrupted = True
                persona_at_exit = "local"
                break

            except Exception as ex:
                record_last_error("ask_chat", "local", str(ex))
                sys.stdout.write(f"{tag('LOCAL', c_red())} Aku gagal jawab dari mode lokal.\n")
                sys.stdout.write(f"{c_dim()}Cek detail lewat: ai \"status\"{c_reset()}\n\n")
                sys.stdout.flush()
                # tetap lanjut loop supaya user bisa coba lagi

        # Kalau user keluar normal, tampilkan goodbye di alt-screen (biar manis),
        # lalu juga akan dicetak ulang di terminal normal setelah alt-screen exit.
        if exit_requested:
            label2, _g, bye2, _sp = persona_for("api" if persona_at_exit == "api" else "local")
            sys.stdout.write("\n")
            sys.stdout.write(f"{c_bold()}{label2}:{c_reset()} {bye2}\n")
            sys.stdout.flush()

        # Memory ringkas (API chat only) — gunakan versi yang sudah kamu sepakati
        if used_api_at_least_once and mode in ("api", "auto"):
            ok, _, _ = validate_api_config(cfg)
            if ok:
                try:
                    convo = []
                    for m in history[-18:]:
                        r = m.get("role")
                        c = str(m.get("content") or "").strip()
                        if not c:
                            continue
                        if r == "user":
                            convo.append(f"User: {c}")
                        elif r == "assistant":
                            convo.append(f"Asisten: {c}")

                    convo_text = "\n".join(convo).strip()

                    # Batasan halus: jangan overwrite kalau chat terlalu pendek
                    if len(convo_text) >= 200 and len(convo) >= 4:
                        summarizer = [
                            {
                                "role": "system",
                                "content": (
                                    "Ringkas percakapan ini untuk memori singkat.\n"
                                    "- Tulis 3–5 kalimat Bahasa Indonesia yang lengkap (tidak boleh kepotong).\n"
                                    "- Sebutkan topik utama + preferensi/keputusan user bila ada.\n"
