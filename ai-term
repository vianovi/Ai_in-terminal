#!/usr/bin/env python3
from __future__ import annotations

import sys

from ai_logic.common import load_config
from ai_logic.ask import mode_ask
from ai_logic.cmd import mode_cmd
from ai_logic.ai import mode_ai


def main() -> int:
    if len(sys.argv) < 3:
        print("Format penggunaan:")
        print('  ask "..."')
        print('  cmd "..."')
        print('  ai "status"')
        print('  ai "--help"')
        return 2

    mode = sys.argv[1].strip().lower()
    text = " ".join(sys.argv[2:]).strip()

    cfg = load_config()

    if mode == "ask":
        return mode_ask(text, cfg)
    if mode == "cmd":
        return mode_cmd(text, cfg)
    if mode == "ai":
        return mode_ai(text, cfg)

    print("Mode tidak dikenal. Pakai: ask / cmd / ai.")
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nDibatalkan oleh pengguna.")
        raise SystemExit(130)
