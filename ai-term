def ask_chat_loop(cfg: dict) -> int:
    mode = backend_mode(cfg)
    backend, route = route_for(cfg, "ask")

    def persona(backend_now: str) -> tuple[str, str, str, str]:
        if backend_now == "api":
            return (
                "Sili Pinter 💬",
                "Iyahh, aku Sili si pintar. Mau ngobrol apa nih, sayang? ✨",
                "Ih kok udahan? Aku tungguin kamu balik lagi ya, sayang 😚 Tata~",
                prompt_api_chat_romantis(),
            )
        return (
            "Sili AI 💬",
            "Hai! Aku Sili AI. Cerita aja, aku dengerin 🤖",
            "Sip, sesi chat-nya aku tutup dulu ya 😉",
            prompt_local_chat(),
        )

    label, greet, bye, sys_prompt = persona(backend)

    mem_ctx = mem_context_text(cfg).strip()
    history: list[dict] = [{"role": "system", "content": sys_prompt}]
    if mem_ctx:
        history.append({"role": "system", "content": mem_ctx})

    alt_screen_enter()
    cursor_hide()
    try:
        clear_screen()
        sys.stdout.write(f"{tag('SILI CHAT', c_cyan())} {tag(mode.upper(), c_yellow())} {c_dim()}•{c_reset()} {route}\n")
        sys.stdout.write(f"{c_dim()}Ketik \"exit\" / \"keluar\" untuk menutup sesi.{c_reset()}\n\n")
        sys.stdout.write(f"{c_bold()}{label}:{c_reset()} {greet}\n\n")
        sys.stdout.flush()

        used_api_at_least_once = False

        while True:
            try:
                flush_stdin()
                user = prompt_text("User 🧑‍💻> ").strip()
            except KeyboardInterrupt:
                sys.stdout.write("\n")
                sys.stdout.write(f"{c_bold()}{label}:{c_reset()} {bye}\n")
                sys.stdout.flush()
                break

            if not user:
                continue
            if user.lower() in ("exit", "keluar", "quit"):
                sys.stdout.write(f"{c_bold()}{label}:{c_reset()} {bye}\n")
                sys.stdout.flush()
                break

            history.append({"role": "user", "content": user})
            flush_stdin()

            # API path
            if backend == "api":
                ok, note, detail = validate_api_config(cfg)
                if not ok:
                    record_last_error("ask_chat", "api", f"{note}\n{detail}")
                    if mode == "api":
                        sys.stdout.write(f"{tag('API', c_yellow())} Aku belum bisa pakai API sekarang. Aku pindah ke lokal dulu ya.\n")
                        sys.stdout.write(f"{c_dim()}(detail: ai \"status\"){c_reset()}\n\n")
                        sys.stdout.flush()
                    backend = "local"
                    label, greet, bye, sys_prompt = persona(backend)
                    history[0] = {"role": "system", "content": sys_prompt}
                    continue

                try:
                    # Spinner chat tanpa timer (sesuai permintaan): aku tidak pakai class Spinner di chat.
                    sys.stdout.write(f"{c_dim()}Aku lagi mikir...{c_reset()} ")
                    sys.stdout.flush()
                    # “Spinner sederhana” tanpa timer:
                    spin_frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
                    stop = threading.Event()

                    def spin():
                        i = 0
                        while not stop.is_set():
                            sys.stdout.write(spin_frames[i % len(spin_frames)])
                            sys.stdout.flush()
                            time.sleep(0.08)
                            sys.stdout.write("\b")
                            i += 1

                    th = threading.Thread(target=spin, daemon=True)
                    th.start()

                    answer = gemini_generate(cfg, history, timeout=90, max_output_tokens=api_tokens_chat())
                    stop.set()
                    th.join(timeout=1)
                    sys.stdout.write(f"{c_green()}✅{c_reset()}\n")
                    sys.stdout.flush()

                    flush_stdin()
                    used_api_at_least_once = True
                    history.append({"role": "assistant", "content": answer})
                    sys.stdout.write(f"{c_dim()}────────────────────────────────────────{c_reset()}\n")
                    sys.stdout.write(f"{c_bold()}{label}:{c_reset()} {answer}\n\n")
                    sys.stdout.flush()
                    continue

                except KeyboardInterrupt:
                    record_last_error("ask_chat", "api", "KeyboardInterrupt saat menunggu API (chat).")
                    flush_stdin()
                    sys.stdout.write("\n")
                    sys.stdout.write(f"{c_bold()}{label}:{c_reset()} {bye}\n")
                    sys.stdout.flush()
                    break
                except Exception as ex:
                    record_last_error("ask_chat", "api", str(ex))
                    flush_stdin()
                    sys.stdout.write(f"{tag('API', c_yellow())} Aku gagal nyambung ke API. Aku pindah ke lokal dulu ya.\n")
                    sys.stdout.write(f"{c_dim()}(detail: ai \"status\"){c_reset()}\n\n")
                    sys.stdout.flush()
                    backend = "local"
                    label, greet, bye, sys_prompt = persona(backend)
                    history[0] = {"role": "system", "content": sys_prompt}
                    continue

            # LOCAL path
            try:
                sys.stdout.write(f"{c_dim()}Aku lagi mikir...{c_reset()} ")
                sys.stdout.flush()
                spin_frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
                stop = threading.Event()

                def spin():
                    i = 0
                    while not stop.is_set():
                        sys.stdout.write(spin_frames[i % len(spin_frames)])
                        sys.stdout.flush()
                        time.sleep(0.08)
                        sys.stdout.write("\b")
                        i += 1

                th = threading.Thread(target=spin, daemon=True)
                th.start()

                host = ollama_host(cfg)
                m = local_model_for(cfg, "ask") or "llama3.1:8b"
                tok = local_tokens_for_chat(user)
                answer = ollama_chat(host, m, history, timeout=260, num_predict=tok)
                stop.set()
                th.join(timeout=1)
                sys.stdout.write(f"{c_green()}✅{c_reset()}\n")
                sys.stdout.flush()

                flush_stdin()
                history.append({"role": "assistant", "content": answer})
                sys.stdout.write(f"{c_dim()}────────────────────────────────────────{c_reset()}\n")
                sys.stdout.write(f"{c_bold()}{label}:{c_reset()} {answer}\n\n")
                sys.stdout.flush()

            except KeyboardInterrupt:
                record_last_error("ask_chat", "local", "KeyboardInterrupt saat menunggu LOCAL (chat).")
                flush_stdin()
                sys.stdout.write("\n")
                sys.stdout.write(f"{c_bold()}{label}:{c_reset()} {bye}\n")
                sys.stdout.flush()
                break
            except Exception as ex:
                record_last_error("ask_chat", "local", str(ex))
                flush_stdin()
                sys.stdout.write(f"{tag('LOCAL', c_red())} Aku gagal jawab dari mode lokal.\n")
                sys.stdout.write(f"{c_dim()}Cek detail lewat: ai \"status\"{c_reset()}\n\n")
                sys.stdout.flush()

        # Memory ringkas (API chat only)
        if used_api_at_least_once and mode in ("api", "auto"):
            ok, _, _ = validate_api_config(cfg)
            if ok:
                try:
                    # Aku ringkas chat saat sesi selesai agar next chat nyambung, tapi tetap hemat token.
                    # Aku juga “saring” pola yang mirip API key supaya tidak tersimpan.
                    convo = []
                    for m in history[-18:]:
                        r = m.get("role")
                        c = str(m.get("content") or "")
                        if not c:
                            continue
                        if r == "user":
                            convo.append(f"User: {c}")
                        elif r == "assistant":
                            convo.append(f"Asisten: {c}")
                    convo_text = "\n".join(convo)

                    summarizer = [
                        {"role": "system", "content": "Ringkas percakapan menjadi 2–3 kalimat Bahasa Indonesia. Jangan simpan data rahasia/credential."},
                        {"role": "user", "content": convo_text},
                    ]
                    summary = gemini_generate(cfg, summarizer, timeout=30, max_output_tokens=140)
                    summary = re.sub(r"(AIza[0-9A-Za-z\-_]+|sk-[0-9A-Za-z]+)", "[REDACTED]", summary)
                    save_memory(summary, cfg)
                except Exception as ex:
                    record_last_error("memory_summary", "api", str(ex))

    finally:
        cursor_show()
        alt_screen_exit()

    return 0


