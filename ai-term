#!/usr/bin/env python3
from __future__ import annotations

import sys

from ai_logic.common import load_config
from ai_logic.bridge import dispatch


def main(argv: list[str]) -> int:
    cfg = load_config()
    return dispatch(argv, cfg)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        # Entry-point tetap tipis: cukup exit code standar.
        print("\nDibatalkan oleh pengguna.")
        raise SystemExit(130)
